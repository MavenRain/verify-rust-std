diff --git a/bin/rust/rust_belt/general.rsspec b/bin/rust/rust_belt/general.rsspec
index dff404f..6ac9f83 100644
--- a/bin/rust/rust_belt/general.rsspec
+++ b/bin/rust/rust_belt/general.rsspec
@@ -172,0 +173,47 @@ type_pred_def for<T> <[T]>.own = slice_own::<T>;
+// A slice borrow retains the ownership of every initialized element.
+pred_ctor slice_full_borrow_content<T>(t: thread_id_t, p: *T, n: usize)() =
+    p[..n] |-> ?values &*& foreach(values, (own)(t));
+
+// T's sharing predicate also describes types with interior mutability.
+pred slice_elements_share<T>(k: lifetime_t, t: thread_id_t, p: *T, n: usize) =
+    0 <= n &*&
+    if n == 0 {
+        true
+    } else {
+        [_](<T>.share)(k, t, p) &*& [_]slice_elements_share(k, t, p + 1, n - 1)
+    };
+
+fix slice_ref_valid<T>(p: *T, n: usize) -> bool {
+    p != 0 &&
+    0 <= std::mem::size_of::<T>() &&
+    p as usize % std::mem::align_of::<T>() == 0 &&
+    0 <= n && n <= usize::MAX &&
+    n * std::mem::size_of::<T>() <= isize::MAX &&
+    pointer_within_limits(p) && pointer_within_limits(p + n)
+}
+
+fix slice_data<T>(p: *_) -> *T {
+    strip_pointer_metadata(p as pointer) as *T
+}
+
+pred_ctor slice_share<T>()(k: lifetime_t, t: thread_id_t, p: *[T]) =
+    slice_ref_valid(slice_data::<T>(p), ptr_len(p)) == true &*&
+    [_]slice_elements_share(k, t, slice_data::<T>(p), ptr_len(p));
+
+type_pred_def for<T> <[T]>.share = slice_share::<T>;
+
+pred_ctor array_own<T, N>()(t: thread_id_t, v: [T; N]) =
+    length(Array_elems(v)) == usize_of_const(typeid(N)) &*&
+    foreach(Array_elems(v), (own)(t));
+
+pred_ctor array_full_borrow_content<T, N>(t: thread_id_t, p: *[T; N])() =
+    *p |-> ?v &*& array_own::<T, N>(t, v);
+
+pred_ctor array_share<T, N>()(k: lifetime_t, t: thread_id_t, p: *[T; N]) =
+    slice_ref_valid(slice_data::<T>(p), usize_of_const(typeid(N))) == true &*&
+    [_]slice_elements_share(k, t, slice_data::<T>(p), usize_of_const(typeid(N)));
+
+type_pred_def for<T, N> <[T; N]>.own = array_own::<T, N>;
+type_pred_def for<T, N> <[T; N]>.full_borrow_content = array_full_borrow_content::<T, N>;
+type_pred_def for<T, N> <[T; N]>.share = array_share::<T, N>;
+
@@ -194 +241 @@ lem close_ref_mut_own<'a, T>(t: thread_id_t, l: &'a mut T);
