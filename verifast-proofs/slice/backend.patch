+              Static))
@@ -1664,0 +1699 @@ module Make (Args : VF_MIR_TRANSLATOR_ARGS) = struct
+    let open Ast in
@@ -1669,2 +1704,8 @@ module Make (Args : VF_MIR_TRANSLATOR_ARGS) = struct
-    let* (CastExpr (_, _, IntLit (_, len, _, _, _))) =
-      translate_ty_const len_cpn loc
+    let* len_ty =
+      match len_cpn.kind with
+      | Param param -> Ok (IdentTypeExpr (loc, None, param.name))
+      | Value _ | Infer | Bound | Placeholder | Unevaluated | Error | Expr ->
+          let* (CastExpr (_, _, IntLit (_, len, _, _, _))) =
+            translate_ty_const len_cpn loc
+          in
+          Ok (LiteralConstTypeExpr (loc, Big_int.int_of_big_int len))
@@ -1673,2 +1714 @@ module Make (Args : VF_MIR_TRANSLATOR_ARGS) = struct
-      Ast.StaticArrayTypeExpr
-        (loc, elem_ty, LiteralConstTypeExpr (loc, Big_int.int_of_big_int len))
+      Ast.StaticArrayTypeExpr (loc, elem_ty, len_ty)
@@ -1678 +1718,4 @@ module Make (Args : VF_MIR_TRANSLATOR_ARGS) = struct
-      Error "Expressing ownership of an array is not yet supported"
+      Ok
+        (CallExpr
+           (loc, "array_own", [elem_ty; len_ty], [],
+            [LitPat tid; LitPat vs], PredCtorCall))
@@ -1681,2 +1724,4 @@ module Make (Args : VF_MIR_TRANSLATOR_ARGS) = struct
-      Error
-        "Expressing the full borrow content of an array is not yet supported"
+      Ok
+        (CallExpr
+           (loc, "array_full_borrow_content", [elem_ty; len_ty], [],
+            [LitPat t; LitPat l], Static))
@@ -1695,3 +1740,6 @@ module Make (Args : VF_MIR_TRANSLATOR_ARGS) = struct
-              Error
-                "Expressing the shared ownership of an array is not yet \
-                 supported");
+              Ok
+                (CoefAsn
+                   (loc, DummyPat,
+                    CallExpr
+                      (loc, "array_share", [elem_ty; len_ty], [],
+                       [LitPat k; LitPat t; LitPat l], PredCtorCall))));
